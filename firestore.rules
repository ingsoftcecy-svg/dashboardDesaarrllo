rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────────
    function estaAutenticado() {
      return request.auth != null;
    }

    // Verifica que el usuario tenga rol 'admin' en la colección usuarios.
    // Usa exists() para no fallar si el documento aún no existe.
    function esAdmin() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    function esAdminODesarrollador() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && (get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin'
          || get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'desarrollador');
    }

    // ── Colección: usuarios ────────────────────────────────────────────────
    // Cada usuario puede leer solo su propio perfil.
    // Solo un admin puede crear, modificar o eliminar perfiles.
    match /usuarios/{uid} {
      allow read: if estaAutenticado() && (request.auth.uid == uid || esAdmin());
      allow write: if esAdmin();
    }

    // ── Colección: historicos_excel ────────────────────────────────────────
    // Lectura: pública (dashboard visible sin login).
    // Escritura: solo administradores.
    match /historicos_excel/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ── Colección: historicos_mensuales ────────────────────────────────────
    match /historicos_mensuales/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ── Colección: config_dashboard ────────────────────────────────────────
    match /config_dashboard/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ── Colección: prerequisitos (Herramientas Digitales) ──────────────────
    // Lectura: pública (visible en el tablero sin login).
    // Escritura: solo usuarios autenticados.
    match /prerequisitos/{docId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // ── Colección: operator_ips (IPs Asignados) ────────────────────────────
    // Lectura: pública (visible en el tablero sin login).
    // Escritura: solo usuarios autenticados.
    match /operator_ips/{docId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // ── Colección: config (IPs globales) ───────────────────────────────────
    match /config/{docId} {
      allow read: if true;
      allow write: if esAdmin();
    }

    // ── Colección: evaluaciones_guias_tecnicas ─────────────────────────────
    // Lectura: pública (progreso visible en tablero sin login).
    // Escritura: solo usuarios autenticados.
    match /evaluaciones_guias_tecnicas/{docId} {
      allow read: if true;
      allow write: if estaAutenticado();
    }

    // ── Colección: operadores_modificados ──────────────────────────────────
    // Lectura: pública (para que el dashboard refleje cambios sin login).
    // Escritura: solo admin o desarrollador.
    match /operadores_modificados/{docId} {
      allow read: if true;
      allow write: if esAdminODesarrollador();
    }

    // ── Colección: audit_logs ──────────────────────────────────────────────
    // Cualquier usuario autenticado puede ESCRIBIR su propio evento.
    // Solo admins pueden LEER el historial de accesos.
    match /audit_logs/{logId} {
      allow create: if estaAutenticado();
      allow read:   if esAdmin();
    }

    // ── Regla de respaldo para cualquier colección futura ──────────────────
    // Por defecto: lectura autenticada, escritura solo admin.
    match /{document=**} {
      allow read: if estaAutenticado();
      allow write: if esAdmin();
    }
  }
}
